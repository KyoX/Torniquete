<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Opcional: solo se usa si el usuario activa "Guardar ubicacion" en Ajustes,
         para dejar evidencia de donde se registro cada marca. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Opcional: solo se usa si el usuario activa "Avisarme al llegar" en
         Ajustes. Desde Android 10 una geocerca solo dispara con la ubicacion
         concedida "todo el tiempo", que es lo que pide este permiso. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Opcional: solo se usa si el usuario activa "Bloqueo con huella o PIN"
         en Ajustes, para pedir la huella o el PIN/patron ya configurados en
         el telefono. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <application
        android:label="Torniquete"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Requeridos por flutter_local_notifications para que las
             notificaciones programadas realmente se muestren y se vuelvan
             a programar despues de reiniciar el telefono. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Vigilancia de llegada a la sede: recibe el aviso del sistema
             cuando el telefono lleva un rato dentro del radio configurado, el
             "ahora no" del propio aviso, y el arranque del telefono, que borra
             las geocercas registradas y obliga a volver a pedirlas.
             exported="false": todos los intents que atiende los envia el
             sistema o la propia app. -->
        <receiver
            android:name=".GeocercaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Widget de la pantalla de inicio: muestra el progreso del dia y la
             hora estimada de salida sin tener que abrir la app. -->
        <!-- exported="true" es obligatorio: el APPWIDGET_UPDATE lo envia el
             sistema, no la app. Solo redibuja con datos locales, asi que no
             expone nada. -->
        <receiver
            android:name=".TorniqueteWidgetProvider"
            android:label="@string/widget_nombre"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_torniquete_info"/>
        </receiver>
        <!-- Ficha de Ajustes rapidos: muestra lo trabajado y la hora de salida
             al desplegar la barra de notificaciones. -->
        <service
            android:name=".TorniqueteTileService"
            android:label="@string/widget_nombre"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Necesario para poder abrir la ubicacion guardada en una app de
             mapas (o, si no hay ninguna, en el navegador). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
