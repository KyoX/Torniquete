<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de progreso del widget. RemoteViews no admite estilos de Material,
     asi que se dibuja a mano: pista azul clara y relleno amarillo, la misma
     combinacion que usa la barra de progreso dentro de la app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_pista" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_acento" />
                <corners android:radius="5dp" />
            </shape>
        </clip>
    </item>
</layer-list>
