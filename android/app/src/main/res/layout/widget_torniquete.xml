<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de la pantalla de inicio. Solo se usan vistas admitidas por
     RemoteViews (LinearLayout, TextView, ProgressBar): un AppWidget no puede
     inflar layouts arbitrarios.

     Las medidas son ajustadas a proposito. Un widget no hace scroll ni se
     encoge: lo que no cabe se corta sin aviso, asi que el alto declarado en
     widget_torniquete_info.xml tiene que dar para todas estas filas.

     El fondo declarado aqui es solo el de arranque: el proveedor lo cambia
     por la variante translucida o transparente segun lo que el usuario haya
     elegido en Ajustes. Los textos llevan sombra siempre; sobre el fondo
     solido no se nota, y es lo que los salva cuando se ve el fondo de
     pantalla por detras. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_estado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/widget_acento"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_estado_inicial" />

        <TextView
            android:id="@+id/widget_actualizado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/widget_texto_suave"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- El total y la meta van en TextViews distintos: juntos en una sola
         cadena a 24sp no caben en un widget de tres celdas de ancho y Android
         los cortaba a la mitad ("6h 35m / 6h 3..."). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_trabajado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/widget_texto"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="1sp"
            android:text="@string/widget_trabajado_inicial" />

        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="@color/widget_texto_suave"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progreso"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progreso" />

    <TextView
        android:id="@+id/widget_salida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_texto"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_marcas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_texto_suave"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- La única marca que falta ahora mismo, para no tener que abrir la app
         y navegar hasta el botón. Se oculta cuando el día no tiene ninguna
         pendiente (festivo, vacaciones, ya cerrado). -->
    <Button
        android:id="@+id/widget_boton_accion"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_boton_fondo"
        android:textColor="@color/widget_fondo"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textStyle="bold"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp" />
</LinearLayout>
